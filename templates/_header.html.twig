<header class="header">
    <div class="container header-container">
        <nav class="header-nav">
            <a href="#" class="nav-link">Health Diary</a>
            <a href="#" class="nav-link">Gallery</a>
            <a href="#" class="nav-link">Walk Map</a>
        </nav>
        <a href="{{ path('app_main') }}" class="header-logo">
            <span class="logo">🐾</span>
        </a>
        <div class="header-auth">
            {% if app.user %}
                <span class="header-user">{{ app.user.name ?: app.user.userIdentifier }}</span>
                <form class="header-logout" action="{{ path('app_logout') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="btn btn-black" type="submit">Logout</button>
                </form>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-white">Login</a>
                <a href="{{ path('app_sign_up') }}" class="btn btn-black">Sign Up</a>
            {% endif %}
        </div>
    </div>
</header>
