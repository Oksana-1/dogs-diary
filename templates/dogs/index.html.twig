{% extends 'base.html.twig' %}
{% block body %}
    <div class="page"
         data-controller="modal dog-edit"
         data-dog-edit-dog-id-value="{{ dog.id }}">
        <div class="container">
            <div class="dog-header">
                <div class="dog-avatar">
                    {% if dog.avatar %}
                        {% if dog.avatar starts with 'images/' %}
                            <img src="{{ asset(dog.avatar) }}" alt="{{ dog.name }} avatar">
                        {% else %}
                            {{ dog.avatar }}
                        {% endif %}
                    {% else %}
                        🐶
                    {% endif %}
                </div>
                <div class="dog-info">
                    <div class="dog-info-header">
                        <h1> {{ dog.name }}</h1>
                        <button type="button"
                                class="icon-button dog-edit-button"
                                title="Edit {{ dog.name }}"
                                aria-label="Edit {{ dog.name }}"
                                data-action="dog-edit#open">✏️</button>
                    </div>
                    <span class="breed-tag">{{ dog.status ?? 'No status' }}</span>
                    <p style="margin-top:6px;">Born {{ dog.birthDate ? dog.birthDate|date('F j, Y') : 'Unknown'  }} · Male · {{ dog.weight }} kg</p>
                    {% if dog.adoptDate %}
                        <p style="margin-top:6px;">Adopted {{ dog.adoptDate|date('F j, Y') }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="button-line">
                <button class="btn-outline" data-action="modal#open">Add treatment</button>
            </div>

            {% set todayTreatments = dog.treatments|filter(t => t.treatmentDate == "now"|date('Y-m-d')) %}
            {% if todayTreatments|length > 0 %}
                <div class="treatments-section">
                    <h2>Today's Treatments</h2>
                    <table class="treatments-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Product</th>
                                <th>Date</th>
                                <th>Next Due</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for treatment in todayTreatments %}
                                <tr data-treatment-id="{{ treatment.id }}">
                                    <td>
                                        {% for type in treatment.types %}
                                            <span class="treatment-badge">{{ type|replace({'_': ' '})|title }}</span>
                                        {% endfor %}
                                    </td>
                                    <td>{{ treatment.productName }}</td>
                                    <td>{{ treatment.treatmentDate }}</td>
                                    <td>{{ treatment.dueDate ?? '—' }}</td>
                                    <td>{{ treatment.note ?? '—' }}</td>
                                    <td class="treatment-actions">
                                        <button type="button" class="action-button action-edit" 
                                                data-treatment-id="{{ treatment.id }}"
                                                data-treatment-type="{{ treatment.types|join(',') }}"
                                                data-treatment-product="{{ treatment.productName }}"
                                                data-treatment-date="{{ treatment.treatmentDate }}"
                                                data-treatment-due="{{ treatment.dueDate }}"
                                                data-treatment-note="{{ treatment.note }}"
                                                title="Edit treatment" aria-label="Edit treatment">✏️</button>
                                        <button type="button" class="action-button action-delete" 
                                                data-treatment-id="{{ treatment.id }}"
                                                data-treatment-product="{{ treatment.productName }}"
                                                title="Delete treatment" aria-label="Delete treatment">🗑️</button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

        </div>
        {% include 'dogs/components/edit_modal.html.twig' %}
        <div class="modal"
             data-modal-target="dialog"
             data-action="click->modal#clickOutside">
            <div class="modal-content">
                <h2>Add Treatment</h2>
                <form data-action="submit->modal#submit">
                    <div class="form-group">
                        <label for="treatment-type">Treatment type</label>
                        <select id="treatment-type" name="type" required>
                            <option value="">Select type</option>
                            <option value="flea_tick">Flea & Tick</option>
                            <option value="anti_worm">Anti Worm</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="product-name">Product / brand name</label>
                        <input type="text" id="product-name" name="product" required>
                    </div>
                    <div class="form-group">
                        <label for="treatment-date">Date of treatment</label>
                        <input type="date" id="treatment-date" name="date" required value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <div class="form-group">
                        <label for="next-due-date">Next due date</label>
                        <input type="date" id="next-due-date" name="next_due">
                    </div>
                    <div class="form-group">
                        <label for="notes">Notes</label>
                        <textarea id="notes" name="notes" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="photo">Photo</label>
                        <input type="file" id="photo" name="photo" accept="image/*">
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
                        <button type="submit" class="btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Treatment Modal -->
        <div class="modal" id="edit-treatment-modal" data-action="click->modal#clickOutside">
            <div class="modal-content">
                <h2>Edit Treatment</h2>
                <form data-action="submit->modal#submit">
                    <input type="hidden" id="edit-treatment-id" name="treatment_id">
                    <div class="form-group">
                        <label for="edit-treatment-type">Treatment type</label>
                        <select id="edit-treatment-type" name="type" required>
                            <option value="">Select type</option>
                            <option value="flea_tick">Flea & Tick</option>
                            <option value="anti_worm">Anti Worm</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="edit-product-name">Product / brand name</label>
                        <input type="text" id="edit-product-name" name="product" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-treatment-date">Date of treatment</label>
                        <input type="date" id="edit-treatment-date" name="date" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-next-due-date">Next due date</label>
                        <input type="date" id="edit-next-due-date" name="next_due">
                    </div>
                    <div class="form-group">
                        <label for="edit-notes">Notes</label>
                        <textarea id="edit-notes" name="notes" rows="3"></textarea>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
                        <button type="submit" class="btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Delete Treatment Modal -->
        <div class="modal" id="delete-treatment-modal" data-action="click->modal#clickOutside">
            <div class="modal-content modal-content-confirm">
                <h2>Delete Treatment</h2>
                <p id="delete-treatment-message">Are you sure you want to delete this treatment?</p>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
                    <button type="button" class="btn-danger">Delete</button>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
