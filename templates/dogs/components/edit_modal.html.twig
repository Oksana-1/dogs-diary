<div class="modal"
     data-dog-edit-target="dialog"
     data-action="click->dog-edit#clickOutside">
    <div class="modal-content">
        <h2>Edit {{ dog.name }}</h2>
        <form data-action="submit->dog-edit#submit">
            <div class="form-group">
                <label for="edit-dog-name">Name</label>
                <input type="text" id="edit-dog-name" name="name" data-dog-edit-target="name" required value="{{ dog.name }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-birth-date">Birth date</label>
                <input type="date" id="edit-dog-birth-date" name="birthDate" data-dog-edit-target="birthDate" required value="{{ dog.birthDate ? dog.birthDate|date('Y-m-d') : '' }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-adopt-date">Adopt date</label>
                <input type="date" id="edit-dog-adopt-date" name="adoptDate" data-dog-edit-target="adoptDate" value="{{ dog.adoptDate ? dog.adoptDate|date('Y-m-d') : '' }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-status">Status</label>
                <input type="text" id="edit-dog-status" name="status" data-dog-edit-target="status" value="{{ dog.status ?? '' }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-avatar">Avatar</label>
                <input type="text" id="edit-dog-avatar" name="avatar" data-dog-edit-target="avatar" value="{{ dog.avatar ?? '' }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-weight">Weight, kg</label>
                <input type="number" id="edit-dog-weight" name="weight" data-dog-edit-target="weight" min="1" value="{{ dog.weight ?? '' }}">
            </div>
            <div class="form-group">
                <label for="edit-dog-height">Height, cm</label>
                <input type="number" id="edit-dog-height" name="height" data-dog-edit-target="height" min="1" value="{{ dog.height ?? '' }}">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" data-action="dog-edit#close">Cancel</button>
                <button type="submit" class="btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
