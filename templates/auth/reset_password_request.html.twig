{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset'|trans }} | Dogs Diary{% endblock %}
{% block header %}<div class="container language-bar">{% include '_language_selector.html.twig' %}</div>{% endblock %}

{% block body %}
    <div id="reset-password-request-app" data-props="{{ {
        formAction: path('app_forgot_password_request'), loginUrl: path('app_login'),
        csrfToken: csrf_token('reset_password_request'), email: request_email, errors: request_errors
    }|json_encode|e('html_attr') }}">
        <section class="auth-page" aria-labelledby="reset-request-title">
            <div class="auth-card">
                <a class="auth-back" href="{{ path('app_login') }}">{{ 'auth.back_arrow'|trans }}</a>
                <div class="auth-heading">
                    <span class="auth-icon auth-icon-emoji" aria-hidden="true">✉️</span>
                    <p class="auth-eyebrow">{{ 'auth.recovery'|trans }}</p>
                    <h1 id="reset-request-title">{{ 'auth.forgot'|trans }}</h1>
                    <p>{{ 'auth.request_intro'|trans }}</p>
                </div>
                <form class="auth-form" action="{{ path('app_forgot_password_request') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password_request') }}">
                    {% if request_errors %}
                        <div id="reset-request-errors" class="auth-errors" role="alert">
                            {% for error in request_errors %}<p>{{ error }}</p>{% endfor %}
                        </div>
                    {% endif %}
                    <div class="auth-field">
                        <label for="reset-email">{{ 'auth.email'|trans }}</label>
                        <input id="reset-email" name="email" type="email" autocomplete="email"
                               placeholder="you@example.com" value="{{ request_email }}" required autofocus
                               {% if request_errors %}aria-invalid="true" aria-describedby="reset-request-errors"{% endif %}>
                    </div>
                    <button class="btn btn-black auth-submit" type="submit">{{ 'auth.send_link'|trans }}</button>
                </form>
                <p class="auth-switch">{{ 'auth.remembered'|trans }} <a href="{{ path('app_login') }}">{{ 'auth.login'|trans }}</a></p>
            </div>
        </section>
    </div>
{% endblock %}
{% block footer %}{% endblock %}
