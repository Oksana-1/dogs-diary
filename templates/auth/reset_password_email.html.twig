<!doctype html>
<html lang="{{ email_locale }}">
<head><meta charset="utf-8"><title>{{ 'auth.email_subject'|trans({}, 'messages', email_locale) }}</title></head>
<body>
    <p>{{ 'auth.email_greeting'|trans({'{name}': user.name}, 'messages', email_locale) }}</p>
    <p>{{ 'auth.email_intro'|trans({}, 'messages', email_locale) }}</p>
    <p><a href="{{ reset_url }}">{{ 'auth.choose_password'|trans({}, 'messages', email_locale) }}</a></p>
    <p>{{ 'auth.email_expiry'|trans({'{minutes}': token_lifetime_minutes, '{expires}': expires_at|date('Y-m-d H:i T')}, 'messages', email_locale) }}</p>
    <p>{{ 'auth.email_ignore'|trans({}, 'messages', email_locale) }}</p>
</body>
</html>
