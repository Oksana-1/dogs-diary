<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Reset your Dogs Diary password</title></head>
<body>
    <p>Hello {{ user.name }},</p>
    <p>We received a request to reset your Dogs Diary password.</p>
    <p><a href="{{ reset_url }}">Choose a new password</a></p>
    <p>This link expires in {{ token_lifetime_minutes }} minutes, at {{ expires_at|date('Y-m-d H:i T') }}.</p>
    <p>If you did not request this, you can safely ignore this email.</p>
</body>
</html>
