{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login'|trans }} | Dogs Diary{% endblock %}

{% block header %}<div class="container language-bar">{% include '_language_selector.html.twig' %}</div>{% endblock %}

{% block body %}
    <div
        id="login-app"
        data-props="{{ {
            formAction: path('app_login'),
            forgotPasswordUrl: path('app_forgot_password_request'),
            signUpUrl: path('app_sign_up'),
            csrfToken: csrf_token('authenticate'),
            lastEmail: last_email,
            error: login_error,
            notices: login_notices
        }|json_encode|e('html_attr') }}"
    >
        <section class="auth-page" aria-labelledby="login-title">
            <div class="auth-card">
                <div class="auth-heading">
                    <span class="auth-icon auth-icon-emoji" aria-hidden="true">🐾</span>
                    <p class="auth-eyebrow">{{ 'auth.welcome'|trans }}</p>
                    <h1 id="login-title">{{ 'auth.login_title'|trans }}</h1>
                    <p>{{ 'auth.login_intro'|trans }}</p>
                </div>

                <form class="auth-form" action="{{ path('app_login') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {% if login_notices %}
                        <div class="auth-notice" role="status">
                            {% for notice in login_notices %}<p>{{ notice }}</p>{% endfor %}
                        </div>
                    {% endif %}

                    {% if login_error %}
                        <div id="login-error" class="auth-errors" role="alert"><p>{{ login_error }}</p></div>
                    {% endif %}

                    <div class="auth-field">
                        <label for="login-email">{{ 'auth.email'|trans }}</label>
                        <input id="login-email" name="email" type="email" autocomplete="email"
                               placeholder="you@example.com" value="{{ last_email }}" required autofocus
                               {% if login_error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                    </div>

                    <div class="auth-field">
                        <div class="auth-label-row">
                            <label for="login-password">{{ 'auth.password'|trans }}</label>
                            <a href="{{ path('app_forgot_password_request') }}">{{ 'auth.forgot'|trans }}</a>
                        </div>
                        <input id="login-password" name="password" type="password" autocomplete="current-password"
                               placeholder="{{ 'auth.password_placeholder'|trans }}" required
                               {% if login_error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                    </div>

                    <label class="auth-check">
                        <input name="remember_me" type="checkbox" value="1">
                        <span>{{ 'auth.remember'|trans }}</span>
                    </label>

                    <button class="btn btn-black auth-submit" type="submit">{{ 'auth.login'|trans }}</button>
                </form>

                <p class="auth-switch">{{ 'auth.new_here'|trans }} <a href="{{ path('app_sign_up') }}">{{ 'auth.create_account'|trans }}</a></p>
            </div>
        </section>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
