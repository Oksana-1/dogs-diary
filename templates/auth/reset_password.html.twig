{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.choose_password'|trans }} | Dogs Diary{% endblock %}
{% block header %}<div class="container language-bar">{% include '_language_selector.html.twig' %}</div>{% endblock %}

{% block body %}
    <div id="reset-password-app" data-props="{{ {
        formAction: path('app_reset_password', {token: reset_token}), loginUrl: path('app_login'),
        csrfToken: csrf_token('reset_password'), errors: reset_errors
    }|json_encode|e('html_attr') }}">
        <section class="auth-page" aria-labelledby="reset-password-title">
            <div class="auth-card">
                <div class="auth-heading">
                    <span class="auth-icon auth-icon-emoji" aria-hidden="true">🔐</span>
                    <p class="auth-eyebrow">{{ 'auth.secure'|trans }}</p>
                    <h1 id="reset-password-title">{{ 'auth.choose_password'|trans }}</h1>
                    <p>{{ 'auth.reset_intro'|trans }}</p>
                </div>
                <form class="auth-form" action="{{ path('app_reset_password', {token: reset_token}) }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                    {% if reset_errors.global is defined %}
                        <div class="auth-errors" role="alert">
                            {% for error in reset_errors.global %}<p>{{ error }}</p>{% endfor %}
                        </div>
                    {% endif %}
                    <div class="auth-field">
                        <label for="reset-password">{{ 'auth.new_password'|trans }}</label>
                        <input id="reset-password" name="password" type="password" autocomplete="new-password"
                               placeholder="{{ 'auth.new_password_placeholder'|trans }}" required minlength="12"
                               {% if reset_errors.password is defined %}aria-invalid="true" aria-describedby="reset-password-error"{% else %}aria-describedby="reset-password-help"{% endif %}>
                        {% if reset_errors.password is defined %}
                            <p id="reset-password-error" class="auth-field-error" role="alert">{{ reset_errors.password|join(' ') }}</p>
                        {% else %}<p id="reset-password-help" class="auth-help">{{ 'auth.password_help'|trans }}</p>{% endif %}
                    </div>
                    <div class="auth-field">
                        <label for="reset-password-confirmation">{{ 'auth.confirm_new'|trans }}</label>
                        <input id="reset-password-confirmation" name="password_confirmation" type="password"
                               autocomplete="new-password" placeholder="{{ 'auth.repeat_new'|trans }}" required minlength="12"
                               {% if reset_errors.password_confirmation is defined %}aria-invalid="true" aria-describedby="reset-password-confirmation-error"{% endif %}>
                        {% if reset_errors.password_confirmation is defined %}
                            <p id="reset-password-confirmation-error" class="auth-field-error" role="alert">{{ reset_errors.password_confirmation|join(' ') }}</p>
                        {% endif %}
                    </div>
                    <button class="btn btn-black auth-submit" type="submit">{{ 'auth.reset'|trans }}</button>
                </form>
                <p class="auth-switch">{{ 'auth.return'|trans }} <a href="{{ path('app_login') }}">{{ 'auth.login_lower'|trans }}</a></p>
            </div>
        </section>
    </div>
{% endblock %}
{% block footer %}{% endblock %}
