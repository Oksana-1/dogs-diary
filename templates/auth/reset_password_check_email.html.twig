{% extends 'base.html.twig' %}

{% block title %}Check Your Email | Dogs Diary{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div
        id="reset-password-check-email-app"
        data-props="{{ {
            loginUrl: path('app_login'),
            requestPasswordUrl: path('app_forgot_password_request'),
            tokenLifetimeMinutes: token_lifetime_minutes
        }|json_encode|e('html_attr') }}"
    >
        <section class="auth-page" aria-labelledby="check-email-title">
            <div class="auth-card">
                <div class="auth-heading auth-heading-spacious">
                    <span class="auth-icon auth-icon-emoji" aria-hidden="true">✅</span>
                    <p class="auth-eyebrow">Almost there</p>
                    <h1 id="check-email-title">Check your email</h1>
                    <p>If an account matches the email you entered, a password reset link is on its way.</p>
                </div>
                <div class="auth-notice"><p>The link expires in {{ token_lifetime_minutes }} minutes. Check your spam folder if you don't see the message.</p></div>
                <a class="btn btn-black auth-submit" href="{{ path('app_login') }}">Back to login</a>
                <p class="auth-switch">Didn't receive an email? <a href="{{ path('app_forgot_password_request') }}">Try again</a></p>
            </div>
        </section>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
