{% extends 'base.html.twig' %}

{% block title %}Check Your Email | Dogs Diary{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div
        id="reset-password-check-email-app"
        data-props="{{ {
            loginUrl: path('app_login'),
            requestPasswordUrl: path('app_forgot_password_request')
        }|json_encode|e('html_attr') }}"
    >
        <span class="vue-loading">Loading email confirmation…</span>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
