{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.check_email'|trans }} | Dogs Diary{% endblock %}

{% block header %}<div class="container language-bar">{% include '_language_selector.html.twig' %}</div>{% endblock %}

{% block body %}
    <div
        id="reset-password-check-email-app"
        data-props="{{ {
            loginUrl: path('app_login'),
            requestPasswordUrl: path('app_forgot_password_request'),
            tokenLifetimeMinutes: token_lifetime_minutes
        }|json_encode|e('html_attr') }}"
    >
        <section class="auth-page" aria-labelledby="check-email-title">
            <div class="auth-card">
                <div class="auth-heading auth-heading-spacious">
                    <span class="auth-icon auth-icon-emoji" aria-hidden="true">✅</span>
                    <p class="auth-eyebrow">{{ 'auth.almost'|trans }}</p>
                    <h1 id="check-email-title">{{ 'auth.check_email'|trans }}</h1>
                    <p>{{ 'auth.neutral_notice'|trans }}</p>
                </div>
                <div class="auth-notice" role="status"><p>{{ 'auth.expiry_notice'|trans({'{minutes}': token_lifetime_minutes}) }}</p></div>
                <a class="btn btn-black auth-submit" href="{{ path('app_login') }}">{{ 'auth.back'|trans }}</a>
                <p class="auth-switch">{{ 'auth.no_email'|trans }} <a href="{{ path('app_forgot_password_request') }}">{{ 'auth.retry'|trans }}</a></p>
            </div>
        </section>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
