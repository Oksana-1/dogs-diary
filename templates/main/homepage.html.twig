{% extends 'base.html.twig' %}
{% block body %}
    <div class="page">
        <section class="full-screen-banner">
            <img class="banner-image" src="{{ asset('images/dogs.jpeg') }}" alt="Best dogs ever">
            <div class="banner-container">
                <div class="banner-text-overlay"></div>
                <div class="banner-text">
                    <h1 class="h1">
                        Best dogs ever
                    </h1>
                </div>
            </div>

        </section>
        <section class="dogs-section">
            <div class="dogs-container">
                {% for dog in dogs %}
                    {% include 'dogs/components/card.html.twig' %}
                {% else %}
                    <p>No dogs found.</p>
                {% endfor %}
            </div>
        </section>
        {{ vue_island('DogsList') }}
        {{ vue_island('Hello', { name: 'Smarty' }) }}
    </div>
{% endblock %}
